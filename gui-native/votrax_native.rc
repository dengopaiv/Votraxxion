// votrax_native.rc - resources for the Votrax Native GUI.
//
// Short, because there is nothing to carry. The sibling GUIs link a
// multi-megabyte pronunciation dictionary in here as RCDATA; this one
// does not need to, because both mask ROMs and the whole English front
// end are already compiled into the synthesizer's own C sources.

#include <windows.h>
#include "resource.h"

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "votrax_native.manifest"

// Keep in step with the version in nvda-addon/manifest.ini.
VS_VERSION_INFO VERSIONINFO
  FILEVERSION     1,2,0,0
  PRODUCTVERSION  1,2,0,0
  FILEFLAGSMASK   0x3fL
  FILEFLAGS       0x0L
  FILEOS          VOS_NT_WINDOWS32
  FILETYPE        VFT_APP
  FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Votrax Native - SC-01 Speech Synthesizer"
            VALUE "FileVersion",     "1.2.0.0"
            VALUE "InternalName",    "votrax_native"
            VALUE "OriginalFilename","votrax_native.exe"
            VALUE "ProductName",     "Votrax Native"
            VALUE "ProductVersion",  "1.2.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
